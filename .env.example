# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Dùng khoá "anon" / "publishable" (công khai, được RLS bảo vệ). KHÔNG BAO GIỜ dùng service_role ở đây.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# true = hiện nút "Đăng nhập Google" cho host (cần bật Google provider trong Supabase Auth)
VITE_ENABLE_GOOGLE=false
# false = ẩn form đăng ký, host do admin tạo sẵn trong Supabase Auth (khuyến nghị khi chạy nội bộ)
VITE_ENABLE_SIGNUP=true
